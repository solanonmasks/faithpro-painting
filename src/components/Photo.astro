---
// Shows a job photo. If the file exists in src/assets/photos/, it is optimised
// to WebP by Astro. Otherwise it falls back to the photo on the client's live site.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  photo: { file: string; remote: string };
  alt: string;
  eager?: boolean;
  class?: string;
  sizes?: string;
}

const { photo, alt, eager = false, class: className, sizes = '100vw' } = Astro.props;
const localPhotos = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.{webp,jpg,jpeg,png,avif}', { eager: true });
const local = localPhotos[`../assets/photos/${photo.file}`]?.default;
const loading = eager ? 'eager' : 'lazy';
---
{local ? (
  <Image
    src={local}
    alt={alt}
    class={className}
    widths={[480, 800, 1200, 1600]}
    sizes={sizes}
    format="webp"
    loading={loading}
    fetchpriority={eager ? 'high' : 'auto'}
    draggable="false"
  />
) : (
  <img src={photo.remote} alt={alt} class={className} loading={loading} decoding="async" draggable="false" />
)}
